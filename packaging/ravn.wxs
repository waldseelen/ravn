<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RAVN"
           Manufacturer="RAVN Team"
           Version="1.2.0"
           UpgradeCode="A3E7216F-8D19-4C90-B8A4-1925D8F2B76D"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of RAVN is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RAVN" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="7B9F1E2A-3D4C-5B6A-7E8F-90123456789A">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="RAVN"
                  Description="RAVN Media Processing Utility"
                  Target="[INSTALLFOLDER]RAVN.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RAVN\RAVN" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- WiX v4 requires components to belong to an explicit Feature; there is no
         implicit default feature (that only arrived in v5). Files must live in a
         ComponentGroup referencing their target Directory by attribute, not nested
         directly inside a Directory element. -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="RAVN" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Icon Id="AppIcon" SourceFile="assets/ravn.ico" />

  </Package>
</Wix>
