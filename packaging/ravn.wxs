<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RAVN"
           Manufacturer="RAVN Team"
           Version="1.0.0"
           UpgradeCode="A3E7216F-8D19-4C90-B8A4-1925D8F2B76D"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of RAVN is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RAVN">
        <Files Include="$(var.SourceDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="7B9F1E2A-3D4C-5B6A-7E8F-90123456789A">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="RAVN"
                  Description="RAVN Media Processing Utility"
                  Target="[INSTALLFOLDER]RAVN.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RAVN\RAVN" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Icon Id="AppIcon" SourceFile="assets/ravn.ico" />

  </Package>
</Wix>
