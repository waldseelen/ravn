# RAVN direct dependencies (source of truth).
# Edit this file, then regenerate the pinned lock with:
#   pip-compile requirements.in -o requirements.txt
#
# requirements.txt is the compiled, fully-pinned lock that CI and the packaged
# build install from.

# --- Core runtime ---
customtkinter>=5.2.0      # desktop UI toolkit (legacy Tkinter UI)
Pillow>=10.0.0            # image handling (icons, thumbnails)
yt-dlp>=2024.1.1          # media download engine
requests>=2.32.0          # HTTP (update checks, thumbnail fetch)
click>=8.1.0             # CLI framework
mutagen>=1.47.0          # audio metadata tagging

# --- API transport (Tauri frontend IPC) ---
fastapi>=0.100.0          # HTTP/WebSocket transport layer for the Tauri frontend
uvicorn[standard]>=0.23.0 # ASGI server (sidecar mode for packaged builds)
pydantic>=2.0.0           # Data validation and settings schemas
starlette>=0.27.0         # ASGI framework underpinning FastAPI
websockets>=11.0          # Real-time WebSocket broadcasting
httpx>=0.24.0             # Test client & HTTP transport

# --- Desktop extras (Windows-first, legacy Tkinter UI) ---
tkinterdnd2>=0.3.0        # drag & drop
pystray>=0.19.0           # system tray

# --- Packaging ---
pyinstaller>=6.22.2          # Windows executable build

